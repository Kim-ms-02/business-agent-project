# 비밀값: API 키와 환경 변수 파일 (.env.example만 허용)
.env*
!.env.example

# 의존성
node_modules/

# 빌드 결과물
# public/vad/는 npm run dev·build 때 node_modules에서 복사한다 (scripts/copy-vad-assets.mjs)
/public/vad/
# public/face/는 npm run dev·build 때 준비한다 (scripts/prepare-face-assets.mjs, 모델은 내려받음)
/public/face/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# next dev가 자동으로 만드는 코딩 도구 안내 (안내는 CLAUDE.md 한 곳에만 둔다)
AGENTS.md

# 테스트·도구 결과물
coverage/
.vercel/

# 녹화 영상·음성 파일 (커밋 금지)
*.webm
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.aac
recordings/

# 실제 발표자의 얼굴 사진·프레임 기록 (커밋 금지)
face-captures/
frame-logs/
*.frames.json

# 대용량 데이터
data/
*.zip
*.tar.gz

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS가 만드는 파일
.DS_Store
Thumbs.db

# 편집기
.idea/
.vscode/*
!.vscode/extensions.json

# README 재료 메모 (커밋하지 않음)
notes/
